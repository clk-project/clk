{
    "alias": {
        "analyse-coverage": {
            "commands": [
                [
                    "exec",
                    "--in-project",
                    "earth",
                    "--artifact",
                    "+local-sanity-check/output"
                ]
            ],
            "documentation": null
        },
        "push": {
            "commands": [
                [
                    "exec",
                    "git",
                    "push"
                ]
            ],
            "documentation": null
        }
    }
}
